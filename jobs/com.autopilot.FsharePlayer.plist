<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.autopilot.myproject</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/thangtran/.local/share/autopilot/run-once.sh</string>
    <string>--project</string>
    <string>a private repository</string>
  </array>

  <!-- No RunAtLoad: the loop runs only in a session the operator started.
       See docs/decisions/0002-off-until-explicitly-started.md. -->
  <key>StartInterval</key><integer>2100</integer>

  <key>StandardOutPath</key><string>a private repository/.autopilot/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>a private repository/.autopilot/logs/launchd.err</string>

  <!-- launchd jobs inherit no login shell, so PATH is set explicitly. Without
       this, gh and jq are simply absent and the failure presents as a queue
       that is permanently empty. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/thangtran/.local/bin</string>
    <key>HOME</key><string>/Users/thangtran</string>
  </dict>
</dict>
</plist>
